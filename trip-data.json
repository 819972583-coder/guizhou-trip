 "days": [
  {
   "id": "day-01",
   "day": 1,
   "date": "2026-09-22",
   "title": "贵阳集合日 · 自由活动",
   "locations": [
    "上海",
    "贵阳龙洞堡机场",
    "贵阳市区"
   ],
   "notes": [
    "今日为集合日，提供 24 小时“无缝衔接”接站服务，送达市区酒店办理入住。",
    "早到可自由游玩：黔灵山公园（看猴子/寺庙）、甲秀楼、省博/地质博物馆。",
    "美食推荐：青云市集、二七小吃街、丝娃娃、肠旺面、凯里酸汤鱼、留一手烤鱼。",
    "行前准备：今日需自行购置次日路餐、头灯电池、防水袋、垃圾袋（详见 To Do）。",
    "穿衣：白天短袖/薄长袖+休闲长裤+舒适运动鞋；傍晚加薄外套。气候多云 18—28℃。"
   ],
   "schedule": [
    {
     "id": "d1-01",
     "time": "07:05—10:05",
     "type": "flight",
     "text": "上海虹桥T1 → 贵阳龙洞堡T2（9C7117 · 春秋航空）",
     "placeIds": [
      "guiyang-airport"
     ]
    },
    {
     "id": "d1-02",
     "time": "抵达后",
     "type": "transfer",
     "text": "24h 接机/接站送至贵阳市区酒店办理入住",
     "placeIds": [
      "guiyang-city"
     ]
    },
    {
     "id": "d1-03",
     "time": "下午",
     "type": "activity",
     "text": "自由活动：黔灵山公园、甲秀楼、省博/地质博物馆"
    },
    {
     "id": "d1-04",
     "time": "晚上",
     "type": "meal",
     "text": "美食推荐：青云市集、二七小吃街、丝娃娃、肠旺面、凯里酸汤鱼"
    }
   ]
  },
  {
   "id": "day-02",
   "day": 2,
   "date": "2026-09-23",
   "title": "羊皮洞瀑布徒步",
   "locations": [
    "贵阳市区",
    "羊皮洞瀑布"
   ],
   "notes": [
    "徒步约 8km，累计爬升约 400m（下降约 300m）；湿滑陡峭，需防滑鞋 + 备换衣裤鞋袜。",
    "中午路餐自带；瀑布附近有村民摆摊卖水/小吃、水靴出租。",
    "穿衣：速干T恤+速干长裤+防滑徒步鞋（可租水靴）；外穿雨衣/冲锋衣，手机相机套防水袋。",
    "气候：晴转小雨 17—27℃，雨后山石湿滑、体感骤降 3—5℃。"
   ],
   "schedule": [
    {
     "id": "d2-01",
     "time": "上午",
     "type": "transfer",
     "text": "乘车约 70km（约1.5h）前往徒步起点"
    },
    {
     "id": "d2-02",
     "time": "上午",
     "type": "activity",
     "text": "下探峡谷，抵达羊皮洞瀑布，水雾中观瀑创作"
    },
    {
     "id": "d2-03",
     "time": "中午",
     "type": "meal",
     "text": "开阔处分享自带路餐"
    },
    {
     "id": "d2-04",
     "time": "下午",
     "type": "activity",
     "text": "探索瀑布旁洞穴，徒步环线返回"
    },
    {
     "id": "d2-05",
     "time": "傍晚",
     "type": "transfer",
     "text": "乘车返回贵阳市区住宿"
    }
   ]
  },
  {
   "id": "day-03",
   "day": 3,
   "date": "2026-09-24",
   "title": "大圣之眼溶洞徒步",
   "locations": [
    "贵阳市区",
    "大圣之眼",
    "安顺市区"
   ],
   "notes": [
    "徒步约 9km，累计爬升约 400m；喀斯特地貌，少许路段需手脚并用攀爬。",
    "洞内常年 12—18℃ 且泥泞；带好头灯+备用电池，穿不怕刮蹭旧衣物，可加薄手套。",
    "穿衣：速干长袖+速干长裤+抓地徒步鞋；出洞后加薄外套防着凉。",
    "气候：多云转阴 17—27℃。"
   ],
   "schedule": [
    {
     "id": "d3-01",
     "time": "上午",
     "type": "transfer",
     "text": "乘车约 120km（约2h）前往徒步起点"
    },
    {
     "id": "d3-02",
     "time": "上午",
     "type": "activity",
     "text": "穿越天坑、崖壁小路与原始灌木林，进入溶洞系统"
    },
    {
     "id": "d3-03",
     "time": "中午",
     "type": "meal",
     "text": "宽敞洞厅内用餐"
    },
    {
     "id": "d3-04",
     "time": "下午",
     "type": "activity",
     "text": "寻找洞顶“大圣之眼”天光，出洞"
    },
    {
     "id": "d3-05",
     "time": "下午",
     "type": "transfer",
     "text": "乘车前往“瀑布之乡”安顺市入住"
    }
   ]
  },
  {
   "id": "day-04",
   "day": 4,
   "date": "2026-09-25",
   "title": "夜郎天路 · 龙脊山",
   "locations": [
    "安顺市区",
    "夜郎天路龙脊山"
   ],
   "notes": [
    "徒步约 10km，海拔爬升约 800m（下降约 500m）；全程强度最大、温差最大。",
    "走乡道、爬坡、穿越蕨类灌木丛与山脊石林；建议护膝，长裤防刮蹭。",
    "穿衣：出发单层速干长袖，登顶 2000m+ 山脊风大温低，包里常备薄抓绒+防风冲锋衣。",
    "气候：阴转雨 17—27℃；夜郎天路山顶体感比市区低 4—6℃、风大。"
   ],
   "schedule": [
    {
     "id": "d4-01",
     "time": "上午",
     "type": "transfer",
     "text": "乘车约 100km（约1.5h）前往徒步起点"
    },
    {
     "id": "d4-02",
     "time": "上午",
     "type": "activity",
     "text": "布依族村寨启程，沿“羊肠小道”持续向上攀登"
    },
    {
     "id": "d4-03",
     "time": "中午",
     "type": "activity",
     "text": "登顶龙脊山（海拔 2000m+），俯瞰峡谷与牂牁江"
    },
    {
     "id": "d4-04",
     "time": "下午",
     "type": "transfer",
     "text": "穿越至终点，乘车返回安顺"
    }
   ]
  },
  {
   "id": "day-05",
   "day": 5,
   "date": "2026-09-26",
   "title": "花江峡谷 · 北盘江大桥",
   "locations": [
    "安顺市区",
    "花江峡谷"
   ],
   "notes": [
    "9 月按季节走 B 线花江峡谷：山脊徒步约 9km，爬升约 300m，预计 4—5 小时。",
    "峡谷风大，休息时及时加衣；前一晚降雨路面湿滑。",
    "穿衣：速干长袖+速干长裤+防滑徒步鞋，冲锋衣/雨衣随身。",
    "气候：雨转阴 16—26℃。备选 A 线关岭冰臼（10月—次年4月）。"
   ],
   "schedule": [
    {
     "id": "d5-01",
     "time": "上午",
     "type": "transfer",
     "text": "乘车约 100km（约1h）前往花江峡谷"
    },
    {
     "id": "d5-02",
     "time": "上午",
     "type": "activity",
     "text": "北盘江大峡谷山脊徒步，仰望“世界第一高桥”花江大桥"
    },
    {
     "id": "d5-03",
     "time": "中午",
     "type": "meal",
     "text": "峡谷中分享自带路餐"
    },
    {
     "id": "d5-04",
     "time": "下午",
     "type": "transfer",
     "text": "乘车返回安顺"
    }
   ]
  },
  {
   "id": "day-06",
   "day": 6,
   "date": "2026-09-27",
   "title": "云鹫山 · 云峰屯堡 → 返程",
   "locations": [
    "安顺市区",
    "云峰屯堡",
    "贵阳龙洞堡机场"
   ],
   "notes": [
    "徒步约 5km，爬升约 300m；以景区游览为主，最轻松的一天。",
    "约 15:00 抵机场、15:30 抵贵阳北站；返程请买 16:30 后高铁或 17:00 后航班。",
    "穿衣：长袖T恤/薄卫衣+休闲长裤+防滑运动鞋，带雨具；登顶风凉加薄外套。",
    "石板路湿滑注意脚下。"
   ],
